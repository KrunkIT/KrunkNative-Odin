	wall_jump       = 1.0,
	strafe_speed    = 1.2,
	can_slide       = true,
	air_strafe      = false,
	auto_jump       = false,
	bullet_drop     = false,
	health_regen    = true,
	kill_rewards    = true,
	headshots_only  = false,
	no_secondaries  = false,
	no_streaks      = false,
	disable_borders = false,
	throwable_melees = true,
	select_team     = false,
	allow_spectate  = true,
	third_person    = false,
	hide_nametags   = false,
	team1_name      = "Team 1",
	team2_name      = "Team 2",
	team1_damage    = 1.0,
