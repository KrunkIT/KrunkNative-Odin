// Weapon IDs follow the browser registry, including unimplemented slots.
WEAPONS_LIST := [?]^Weapon{
	&WEAPON_AWP,
	&WEAPON_AK47,
	&WEAPON_PISTOL,
	&WEAPON_SMG,
	&WEAPON_REVOLVER,
	&WEAPON_SHOTGUN,
	&WEAPON_LMG,
	&WEAPON_SEMI_AUTO,
	&WEAPON_RPG,
	&WEAPON_AKIMBO,
	&WEAPON_DEAGLE,
	&WEAPON_ALIEN_BLASTER,
	&WEAPON_KNIFE,
	nil, // Weapon ID 13 (Crossbow) is not implemented yet.
	&WEAPON_FAMAS,
	nil, // 15: Sawed Off
	nil, // 16: Auto Pistol
	nil, // 17: Bomb
	&WEAPON_BLASTER, // 18: Trooper's primary
}

g_weapons :: proc() -> []^Weapon {
	return WEAPONS_LIST[:]
}
