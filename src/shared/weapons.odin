// Matches g_weapons[] ordering in the C port (weapon index == position).
WEAPONS_LIST := [?]^Weapon{
	&WEAPON_AWP,
	&WEAPON_AK47,
	&WEAPON_PISTOL,
	&WEAPON_SMG,
	&WEAPON_REVOLVER,
	&WEAPON_SHOTGUN,
	&WEAPON_LMG,
	&WEAPON_SEMI_AUTO,
	&WEAPON_RPG,
	&WEAPON_AKIMBO,
	&WEAPON_DEAGLE,
	&WEAPON_ALIEN_BLASTER,
	&WEAPON_KNIFE,
}

g_weapons :: proc() -> []^Weapon {
	return WEAPONS_LIST[:]
}
